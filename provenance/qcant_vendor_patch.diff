+class _ProjectionAccumulator:
+    """Incrementally maintain projected overlap/Hamiltonian matrices."""
+
+    def __init__(self, h_qulacs, np, *, max_workers: Optional[int], capacity: Optional[int] = None):
+        self.h_qulacs = h_qulacs
+        self.np = np
+        self.max_workers = max_workers
+        initial_capacity = max(1, int(capacity)) if capacity is not None else 8
+        self._states = []
+        self._vectors = []
+        self._norms = np.zeros(initial_capacity, dtype=float)
+        self._overlap = np.zeros((initial_capacity, initial_capacity), dtype=complex)
+        self._h_proj = np.zeros((initial_capacity, initial_capacity), dtype=complex)
+
+    @property
+    def size(self) -> int:
+        return len(self._states)
+
+    def _ensure_capacity(self, size: int) -> None:
+        if size <= self._overlap.shape[0]:
+            return
+        new_capacity = max(size, 2 * self._overlap.shape[0])
+        self._norms = self.np.pad(self._norms, (0, new_capacity - self._norms.shape[0]))
+        self._overlap = self.np.pad(
+            self._overlap,
+            ((0, new_capacity - self._overlap.shape[0]), (0, new_capacity - self._overlap.shape[1])),
+        )
+        self._h_proj = self.np.pad(
+            self._h_proj,
+            ((0, new_capacity - self._h_proj.shape[0]), (0, new_capacity - self._h_proj.shape[1])),
+        )
+
+    def append(self, state) -> None:
+        np = self.np
+        stored_state = state.copy()
+        vector = np.asarray(stored_state.get_vector(), dtype=complex)
+        norm = float(np.linalg.norm(vector))
+        if not np.isfinite(norm) or norm == 0.0:
+            raise ValueError("projected basis contains a zero- or non-finite-norm vector")
+
+        idx = self.size
+        self._ensure_capacity(idx + 1)
+        if idx:
+            existing = np.stack(self._vectors, axis=0)
+            overlaps = existing.conj() @ vector
+            self._overlap[:idx, idx] = overlaps
+            self._overlap[idx, :idx] = overlaps.conj()
+        self._overlap[idx, idx] = norm * norm
+
+        self._states.append(stored_state)
+        self._vectors.append(vector)
+        self._norms[idx] = norm
+
+        def _compute_value(row_idx: int):
+            bra = self._states[row_idx]
+            return row_idx, complex(self.h_qulacs.get_transition_amplitude(bra, stored_state))
+
+        worker_count = 1 if self.max_workers is None else max(1, int(self.max_workers))
+        if worker_count > 1 and idx > 1:
+            with ThreadPoolExecutor(max_workers=worker_count) as executor:
+                futures = [executor.submit(_compute_value, row_idx) for row_idx in range(idx + 1)]
+                for future in as_completed(futures):
+                    row_idx, value = future.result()
+                    self._h_proj[row_idx, idx] = value
+                    if row_idx != idx:
+                        self._h_proj[idx, row_idx] = np.conj(value)
+        else:
+            for row_idx in range(idx + 1):
+                _, value = _compute_value(row_idx)
+                self._h_proj[row_idx, idx] = value
+                if row_idx != idx:
+                    self._h_proj[idx, row_idx] = np.conj(value)
+
+    def basis_array(self):
+        if not self._vectors:
+            raise ValueError("projected basis is empty")
+        return self.np.stack(self._vectors, axis=0)
+
+    def energies(self, overlap_tol: float, size: Optional[int] = None):
+        np = self.np
+        prefix_size = self.size if size is None else int(size)
+        if prefix_size <= 0 or prefix_size > self.size:
+            raise ValueError("invalid projected-basis prefix size")
+        norms = self._norms[:prefix_size]
+        norm_scales = norms[:, None] * norms[None, :]
+        overlap = self._overlap[:prefix_size, :prefix_size] / norm_scales
+        h_proj = self._h_proj[:prefix_size, :prefix_size] / norm_scales
+        return _diagonalize_projected(overlap, h_proj, overlap_tol, np)
+
+
