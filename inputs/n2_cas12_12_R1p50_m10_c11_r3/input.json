{
  "name": "n2_cas12_12_R1p50_m10_c11_r3",
  "label": "N2 CAS(12e,12o) R=1.50 A",
  "molecule": {
    "distance_ang": 1.5,
    "basis": "6-31g",
    "unit": "Angstrom",
    "charge": 0,
    "spin": 0,
    "verbose": 0
  },
  "cas": {
    "ncas": 12,
    "nelecas": 12,
    "ncore": 1
  },
  "study": {
    "max_cumulative_iterations": 300,
    "stop_abs_delta_mHa": 1e-05,
    "error_unit": "mHa",
    "plot_yscale": "log",
